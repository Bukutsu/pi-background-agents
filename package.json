{
  "name": "pi-bg",
  "version": "0.2.0",
  "description": "Minimal, SDK-native background execution and subagents for Pi",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "background",
    "subagent",
    "bash-bg",
    "async"
  ],
  "license": "MIT",
  "author": "Bukutsu",
  "files": [
    "bg.ts",
    "skills",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run check"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bukutsu/pi-bg.git"
  },
  "homepage": "https://github.com/Bukutsu/pi-bg#readme",
